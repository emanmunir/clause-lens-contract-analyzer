# Clause Lens — Backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
# Your Anthropic API key. When this is UNSET (or empty), the backend runs in
# MOCK mode: it returns a realistic canned analysis so the app works with no
# keys and the test suite passes offline.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# The Claude model used for analysis. Defaults to "claude-opus-4-8".
# Do NOT append a date suffix to the model id.
ANTHROPIC_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Defaults to the Vite dev server origin.
CORS_ORIGINS=http://localhost:5173
